{
  "expo": {
    "name": "Fincake",
    "slug": "portfolio-mobile",
    "scheme": "portfolio-mobile",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-green.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.fincake.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fincake.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#171e2a",
        "foregroundImage": "./assets/android-icon-green-foreground.png",
        "monochromeImage": "./assets/android-icon-green-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon-green.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "47799361-8b3f-498c-9bc5-b6de20f5d61f"
      }
    },
    "owner": "fincake"
  }
}
